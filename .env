# 仓库提供本 .env 空凭据模板；直接填写下面三项上游账户参数后运行。
# 发布源码时保持账号、登录密码和支付密码为空，实际运行值仅留在部署环境。
# 含空格、#、$ 等特殊字符的值建议用单引号包裹，兼容 Docker Compose 与 Shell 加载。

# ===== 上游接口与业务开关 =====
# 上游 API 基础地址，两种业务共用；默认地址已包含 /api/v1，一般无需修改。
UPSTREAM_BASE=https://likayi.com/api/v1

# 是否启用 Apple 礼品卡业务：1=开启，0=关闭；与 ENABLE_AI 至少开启一项。
ENABLE_GIFTCARD=1

# 是否启用 AI 代充业务：1=开启，0=关闭；与 ENABLE_GIFTCARD 至少开启一项。
ENABLE_AI=1

# ===== 共用上游账户（礼品卡 + AI 代充） =====
# 两种业务共用的上游登录账号；只开启其中一种业务时也填写本项，不是客户待充值的账号。
UPSTREAM_USER=

# 共用上游登录密码；启用任意业务时必填，不是客户的 Apple ID 或 AI 代充登录密码。
UPSTREAM_PASS=

# 共用上游支付密码，用于礼品卡和 AI 代充从同一商户钱包扣款下单；启用任意业务时必填。
UPSTREAM_PAY_PASS=


# ===== 售价设置 =====
# 礼品卡价格调整百分比：3=加价3%，-3=按3%计算优惠，0=不调整；支持小数，不填写 % 字符。
# 成本=面值×上游汇率+上游服务费（保留到分）；调整金额=向上取整(成本×本项÷100)，售价=成本+调整金额。
PROFIT=3

# AI 代充价格调整百分比：正数加价、负数优惠，无需额外开关；本模板填 0 表示不调整，成本为上游套餐人民币价格。
# 若完全省略 AI_PROFIT 环境变量，后端回退默认值为 3。
# 带符号的调整金额向上取整到元，不是将最终售价取整；成本 100、填 -3，售价为 97。
# 成本 99.50、填 -3 时，-2.985 元向上取整为 -2 元，售价为 97.50；百分比须大于 -100。
AI_PROFIT=0


# ===== 服务与持久化 =====
# 应用 HTTP 监听端口，默认 9006；Compose 同时用作宿主机回环端口和 Caddy 上游端口。
# 修改后需同步核对 PUBLIC_ORIGIN；这不是对外 HTTPS 的 443 端口。
PORT=9006

# SQLite 数据库文件路径；Docker 中 /app/data 挂载到工程的 ./data，默认路径用于持久化。
# 直接运行 Python 时改为 ./data/shop.db；父目录需要有写入权限。
DB_FILE=/app/data/shop.db

# 应用监听地址：Docker 容器内使用 0.0.0.0，Compose 会固定覆盖为该值。
# 宿主机发布端口仍仅绑定 127.0.0.1；直接运行 Python 时可设为 127.0.0.1。
BIND_HOST=0.0.0.0

# 浏览器实际访问的站点来源，用于校验请求 Origin；填写协议+域名/IP+非默认端口，不带路径。
# 本地示例为 http://localhost:9006；HTTPS 组合配置会自动覆盖为 https://${DOMAIN}。
PUBLIC_ORIGIN=http://localhost:9006

# 是否信任反向代理传入的 X-Real-IP，用于客户端 IP 限流：0=不信任（默认），1=信任。
# 仅在由可信代理覆盖该请求头时设为 1；HTTPS 组合配置会自动设置为 1。
TRUST_PROXY=0

# ===== 可选 HTTPS / Caddy =====
# 使用 docker-compose.https.yml 时必填；填写已解析到服务器的正式域名，如 shop.example.com。
# 不带协议、端口或路径；Caddy 使用它申请证书，服务器需放通 80/443；仅本地 HTTP 可留空。
DOMAIN=
